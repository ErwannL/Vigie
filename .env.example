# Copy to .env, then `docker compose up`. Values below are for a local demo only.

# --- Mode ---------------------------------------------------------------------
# development: missing adapter settings select fakes (fixtures). production: they are disabled.
VIGIE_MODE=development
VIGIE_LOG_LEVEL=info

# --- Storage (docker compose builds DATABASE_URL from these) ---------------------
POSTGRES_USER=vigie
POSTGRES_PASSWORD=vigie
POSTGRES_DB=vigie

# --- Ingestion: one secret per Orqea environment (>= 32 chars, else treated as absent) ---
VIGIE_INGEST_SECRET_DEV=dev-ingest-secret-change-me-0000000000
VIGIE_INGEST_SECRET_RECETTE=recette-ingest-secret-change-me-00000
VIGIE_INGEST_SECRET_PROD=prod-ingest-secret-change-me-000000000

# --- Dashboard single sign-on (>= 32 chars each, and they must differ) ----------------
VIGIE_SSO_SECRET=sso-shared-with-orqea-admin-change-me-00
VIGIE_SESSION_SECRET=vigie-session-secret-change-me-000000000
VIGIE_SESSION_TTL_SECONDS=1800
# Expected `iss` of the handoff token. Orqea's admin handoff factory signs orqea-admin-console.
VIGIE_SSO_ISSUER=orqea-admin-console
# Space- or comma-separated origins allowed to embed the dashboard (CSP frame-ancestors).
# The keywords self and none may be written without quotes.
VIGIE_ALLOWED_FRAME_ANCESTORS=self http://localhost:5174
# Public URL of the dashboard, used for evidence links in issue cards.
VIGIE_PUBLIC_URL=http://localhost:8080
# Target of the dashboard's « ← Back to Orqea » / « Powered by Orqea » links, exposed publicly
# on /healthz (orqeaUrl). http(s) only; default https://orqea.dev.
VIGIE_ORQEA_URL=http://localhost:3001/apps/return

# --- Privacy -------------------------------------------------------------------------
VIGIE_RAW_RETENTION_DAYS=60

# --- Observability sources, per Orqea environment (empty = fake in development) ------
VIGIE_LOKI_URL_DEV=
VIGIE_LOKI_URL_RECETTE=
VIGIE_LOKI_URL_PROD=
VIGIE_PROMETHEUS_URL_DEV=
VIGIE_PROMETHEUS_URL_RECETTE=
VIGIE_PROMETHEUS_URL_PROD=
VIGIE_ERRORS_URL_DEV=
VIGIE_ERRORS_URL_RECETTE=
VIGIE_ERRORS_URL_PROD=
VIGIE_ERRORS_TOKEN_DEV=
VIGIE_ERRORS_TOKEN_RECETTE=
VIGIE_ERRORS_TOKEN_PROD=
# GlitchTip/Sentry project as org/project (the URL above is the instance base URL,
# e.g. https://glitchtip.example). Without a valid org/project the source is not configured.
VIGIE_ERRORS_PROJECT_DEV=
VIGIE_ERRORS_PROJECT_RECETTE=
VIGIE_ERRORS_PROJECT_PROD=
# Loki stream selector for Orqea's backend (every other field is in the JSON line).
VIGIE_LOKI_SELECTOR={container=~".*backend.*"}
# Prometheus latency histogram (its `route` label is the Express route template).
VIGIE_PROMETHEUS_METRIC=orqea_http_request_duration_seconds_bucket
VIGIE_HTTP_TIMEOUT_MS=5000

# --- Figura: only dev and recette exist. There is deliberately no prod setting. ------
VIGIE_FIGURA_URL_DEV=
VIGIE_FIGURA_URL_RECETTE=
# Bearer token per target (>= 32 chars; a target without a valid token is not configured).
VIGIE_FIGURA_TOKEN_DEV=
VIGIE_FIGURA_TOKEN_RECETTE=
# Replay new incidents automatically in this target (dev|recette), empty = operator decides.
VIGIE_AUTO_REPLAY_TARGET=

# --- Output to Orqea's issue board -----------------------------------------------------
# Orqea endpoint: POST {url} opens a card, PUT {url}/{ref} updates it.
VIGIE_ISSUES_URL=
VIGIE_ISSUES_TOKEN=

# --- Detection -----------------------------------------------------------------------
VIGIE_DETECT_INTERVAL_SECONDS=300
VIGIE_DETECT_WINDOW_MINUTES=60
VIGIE_DETECT_BASELINE_DAYS=7

# --- Seed ----------------------------------------------------------------------------
# Multiplies the demo dataset (1 = ~3,400 visitors, ~140k events).
VIGIE_SEED_SCALE=1

# --- Host ports ----------------------------------------------------------------------
VIGIE_API_PORT=3000
VIGIE_DASHBOARD_PORT=8080
